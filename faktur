            document.getElementById('clientAddress').value = "Jl. Sudirman No. 88, Surabaya, Jawa Timur";
            
            document.getElementById('invoiceNo').value = "INV-" + Math.floor(100000 + Math.random() * 900000);
            document.getElementById('paymentStatus').value = "LUNAS";
