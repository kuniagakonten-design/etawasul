            renderFormItems();
            updateInvoice();
        }

        // Download Invoice as PDF using html2pdf.js
        function downloadPDF() {
            const element = document.getElementById('invoicePaper');
            const clientName = document.getElementById('clientName').value || 'Pelanggan';
            const invoiceNo = document.getElementById('invoiceNo').value || 'Faktur';

            const opt = {
                margin:       [0.3, 0.3, 0.3, 0.3],
                filename:     `${invoiceNo}_${clientName.replace(/\s+/g, '_')}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save();
        }

        // On DOM Loaded
        document.addEventListener('DOMContentLoaded', () => {
            setDefaultDate();
            renderFormItems();
            updateInvoice();
        });
    </script>
